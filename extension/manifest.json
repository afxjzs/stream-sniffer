{
  "manifest_version": 3,
  "name": "Stream Sniffer",
  "version": "0.1.0",
  "description": "Captures HLS (.m3u8) streams a page plays, with the headers needed to replay them in VLC or a built-in player.",
  "permissions": ["webRequest", "storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Stream Sniffer",
    "default_popup": "popup.html"
  }
}
